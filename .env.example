# ───── دامنه ─────
# دامنه‌ی سایت (بدون https). رکورد A دامنه و www باید به IP سرور اشاره کند.
DOMAIN=keyfit.ir

# ───── امنیت ─────
# یک رشته‌ی تصادفی طولانی؛ مثلاً خروجی: openssl rand -hex 32
APP_SECRET=
# شماره‌ی موبایل مدیر کل (با همین شماره وارد شوید تا پنل مدیریت فعال باشد)
ADMIN_PHONE=0912xxxxxxx

# ───── حالت نمایشی ─────
# 1 = داده‌های نمونه + کد ثابت ۱۲۳۴ + ورود سریع (فقط برای ارائه و تست). برای نسخه‌ی واقعی 0 بگذارید.
DEMO_MODE=0

# ───── پیامک (کاوه‌نگار) ─────
# در پنل کاوه‌نگار یک قالب Verify با متن «کد ورود کی‌فیت: %token» بسازید و نامش را اینجا بنویسید.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=keyfit-otp

# ───── درگاه پرداخت (زرین‌پال) ─────
# بدون مرچنت، پرداخت شبیه‌سازی می‌شود (فقط برای تست).
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0

# ───── هوش مصنوعی فیت‌یار (اختیاری) ─────
# بدون کلید، مشاور داخلی پاسخ می‌دهد. تشخیص کالری از عکس فقط با کلید فعال است.
ANTHROPIC_API_KEY=
# در صورت نیاز به پراکسی برای دسترسی به API:
# ANTHROPIC_BASE_URL=

# ───── اعلان گوشی (Web Push) ─────
# ساخت کلید: docker compose run --rm app npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@keyfit.ir
